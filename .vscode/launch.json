{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "StratuxHud",
            "type": "debugpy",
            "request": "launch",
            "program": "${cwd}/stratux_hud.py",
            "console": "integratedTerminal",
            "args": [
                "software"
            ]
        },
        {
            "name": "VIEW: Top View Scope",
            "type": "debugpy",
            "request": "launch",
            "module": "views.adsb_top_view_scope",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "software"
            ]
        },
        {
            "name": "VIEW: Traffic Listing",
            "type": "debugpy",
            "request": "launch",
            "module": "views.adsb_traffic_listing",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "software"
            ]
        },
        {
            "name": "VIEW: METARs",
            "type": "debugpy",
            "request": "launch",
            "module": "views.metar_listings",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "software"
            ]
        },
        {
            "name": "VIEW: Weather Scope",
            "type": "debugpy",
            "request": "launch",
            "module": "views.weather_scope",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "software"
            ]
        },
        {
            "name": "VIEW: Frequencies",
            "type": "debugpy",
            "request": "launch",
            "module": "views.airport_frequencies_listing",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "software"
            ]
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}